<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    <%= locals.title ? title + ' | ' : '' %>Sherubtse College
  </title>

  <link rel="stylesheet" href="/css/sherubtse.css">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

  <a class="skip-link" href="#main-content">
    Skip to main content
  </a>

  <header class="site-header">

    <div class="container site-header__inner">

      <!-- Sherubtse College Logo -->
      <a
        href="/"
        class="site-logo"
        aria-label="Sherubtse College Home"
      >
        <img
          src="/images/sherubtse-logo.png"
          alt="Sherubtse College"
          class="site-logo__image"
          width="100"
          height="100"
        >
      </a>

      <!-- Application Navigation -->
      <%- include('navbar') %>

      <!-- Search icon -->
      <button
        type="button"
        class="header-search"
        aria-label="Search"
        title="Search"
      >
        <span class="search-icon" aria-hidden="true"></span>
      </button>

    </div>

  </header>

  <%- include('flash-messages') %>

  <main id="main-content" class="container main-content">