<%- include('../partials/header', { title: locals.title || 'Venue' }) %>
<%
  const errors = locals.errors || {};
  const values = locals.values || {};
%>

<p class="page-actions"><a href="/superadmin/venues">&larr; Back to venues</a></p>

<section class="auth-card">
  <h1><%= heading %></h1>

  <form method="POST" action="<%= action %>" novalidate>
    <div class="form-group">
      <label for="name">Name</label>
      <input class="form-control" type="text" id="name" name="name" maxlength="120"
             value="<%= values.name || '' %>" required>
      <% if (errors.name) { %><p class="field-error"><%= errors.name.msg %></p><% } %>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input class="form-control" type="text" id="location" name="location" maxlength="255"
             value="<%= values.location || '' %>" required>
      <% if (errors.location) { %><p class="field-error"><%= errors.location.msg %></p><% } %>
    </div>

    <div class="form-group">
      <label for="capacity">Capacity</label>
      <input class="form-control" type="number" id="capacity" name="capacity" min="1"
             value="<%= values.capacity || '' %>" required>
      <% if (errors.capacity) { %><p class="field-error"><%= errors.capacity.msg %></p><% } %>
    </div>

    <div class="form-group">
      <label for="description">Description (optional)</label>
      <textarea class="form-control" id="description" name="description" rows="3"
                maxlength="1000"><%= values.description || '' %></textarea>
      <% if (errors.description) { %><p class="field-error"><%= errors.description.msg %></p><% } %>
    </div>

    <button type="submit" class="btn btn--primary btn--block">Save venue</button>
  </form>
</section>

<%- include('../partials/footer') %>